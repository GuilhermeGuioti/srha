DATABASE_URL=
DIRECT_URL=
AUTH_SECRET=
# Microsoft Entra ID (App registration feito pela TI). As três juntas ou nenhuma: sem
# elas o provider não sobe e o botão da Microsoft some do /login; pela metade, a
# aplicação não inicia. ISSUER é o do tenant, nunca common/organizations:
# https://login.microsoftonline.com/<tenant-id>/v2.0
AUTH_MICROSOFT_ENTRA_ID_ID=
AUTH_MICROSOFT_ENTRA_ID_SECRET=
AUTH_MICROSOFT_ENTRA_ID_ISSUER=
# Só no seed de produção (NODE_ENV=production): conta institucional da primeira secretaria.
SECRETARIA_INICIAL_EMAIL=
SECRETARIA_INICIAL_NOME=
# Senha provisória da primeira secretaria, para entrar sem o Entra ID (em desenvolvimento,
# a de admin@srha.dev). Só vale se ela ainda não tiver senha; ela troca no primeiro acesso.
# Apague depois do seed.
SECRETARIA_INICIAL_SENHA=
# Chaves do carimbo de autenticidade do PDF, "versão:chave-base64", separadas por vírgula.
# Gere com: openssl rand -base64 32. Nunca remova uma versão antiga (ver CLAUDE.md).
CHAVES_CARIMBO=
